{
  "name": "specs",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, offline-first specification authoring for AI agents (MCP + Git)",
  "scripts": {
    "start": "node server/index.js",
    "pretest": "npm --prefix web run build",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "test": "node --test \"tests/**/*.test.mjs\" && npm --prefix web test && node web/e2e/ui.test.mjs",
    "ux-audit": "node scripts/ux-audit.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm --prefix web run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
